package.json
    api-tests.js


{
  "name": "reqres-api-testing",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test"
  }
}

const { test } = require('node:test');
const assert = require('node:assert/strict');

const BASE_URL = 'https://reqres.in/api';

test('API01 - GET users successfully', async () => {
  const response = await fetch(`${BASE_URL}/users?page=2`);
  const body = await response.json();

  assert.equal(response.status, 200);
  assert.ok(Array.isArray(body.data));
  assert.ok(body.data.length > 0);
  assert.ok('page' in body);
  assert.ok('total' in body);
  assert.ok('email' in body.data[0]);
});

test('API02 - POST create user', async () => {
  const response = await fetch(`${BASE_URL}/users`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      name: 'Ishan',
      job: 'QA Tester'
    })
  });

  const body = await response.json();

  assert.equal(response.status, 201);
  assert.equal(body.name, 'Ishan');
  assert.equal(body.job, 'QA Tester');
  assert.ok(body.id);
  assert.ok(body.createdAt);
});

test('API03 - Login with missing password', async () => {
  const response = await fetch(`${BASE_URL}/login`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      email: 'peter@klaven'
    })
  });

  const body = await response.json();

  assert.equal(response.status, 400);
  assert.equal(body.error, 'Missing password');
});

test('API04 - User not found', async () => {
  const response = await fetch(`${BASE_URL}/users/999`);
  const body = await response.json();

  assert.equal(response.status, 404);
  assert.deepEqual(body, {});
});
